<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Vineys Reader</title>
<meta name="description" content="Vineys Reader — a page-turning book reader.">
<meta name="theme-color" content="#4a7fb5">
<link rel="manifest" href="manifest.json">
<link rel="icon" type="image/png" sizes="32x32" href="icons/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="icons/favicon-16.png">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Vineys Reader">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --stage-bg-1: #f8f1e3;
    --stage-bg-2: #e9dcc3;
    --case-blue: #8a6444;
    --case-blue-dark: #5c4128;
    --accent: #6b4423;
    --accent-light: #a97a44;
    --paper: #faf3e2;
    --ink: #3b2a17;
    --ribbon: #8a4a3a;
    --page-w: 440px;
    --page-h: 620px;
    --page-count: 2;
    --scale: 1;
  }

  * { box-sizing: border-box; }

  html, body {
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 30%, var(--stage-bg-1), var(--stage-bg-2) 70%);
    font-family: 'Inter', sans-serif;
  }

  .stage {
    position: relative;
    height: 100%;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .stage.zoomed {
    overflow: auto;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 60px;
  }

  /* ---------- Top chrome ---------- */
  .topbar {
    position: absolute;
    top: 0; left: 0; right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    row-gap: 10px;
    padding: 16px 20px;
    z-index: 50;
  }
  .brand {
    font-family: 'Libre Caslon Text', serif;
    font-weight: 700;
    color: var(--accent);
    font-size: 18px;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .brand span.book-title {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 12px;
    color: #a9906a;
    letter-spacing: 0.03em;
  }
  .topbar-controls { display: flex; gap: 8px; flex-wrap: wrap; }
  .chrome-btn {
    background: #faf3e2;
    border: 1px solid #c9a877;
    color: var(--accent);
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 8px 12px;
    border-radius: 4px;
    cursor: pointer;
  }
  .chrome-btn:hover { background: #ecdfc0; }
  .chrome-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chrome-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

  .btn-group {
    display: flex;
    border: 1px solid #c9a877;
    border-radius: 4px;
    overflow: hidden;
  }
  .btn-group button {
    background: #faf3e2;
    border: none;
    color: var(--accent);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 12px;
    cursor: pointer;
    border-right: 1px solid #c9a877;
  }
  .btn-group button:last-child { border-right: none; }
  .btn-group button:hover { background: #ecdfc0; }
  .btn-group button.active { background: var(--accent); color: #fff; }
  .btn-group button:disabled { opacity: 0.4; cursor: default; }

  /* ---------- The book ---------- */
  .book-wrap { transform: scale(var(--scale)); transition: transform 0.15s ease; }

  .book {
    position: relative;
    width: calc(var(--page-w) * var(--page-count) + 56px);
    height: calc(var(--page-h) + 48px);
    padding: 24px 28px;
    background:
      repeating-linear-gradient(135deg, rgba(255,255,255,0.035) 0px, rgba(255,255,255,0.035) 1px, transparent 1px, transparent 3px),
      linear-gradient(160deg, var(--case-blue), var(--case-blue-dark));
    border-radius: 12px;
    box-shadow: 0 30px 70px rgba(60,35,15,0.35), 0 8px 20px rgba(60,35,15,0.25), inset 0 0 0 2px rgba(212,182,132,0.28), inset 0 0 24px rgba(0,0,0,0.18);
    transition: width 0.25s ease;
  }
  .book::before, .book::after {
    content: "";
    position: absolute;
    top: 32px;
    bottom: 32px;
    width: 6px;
    background: repeating-linear-gradient(to bottom, #efe2bf 0px, #efe2bf 2px, #d6c294 2px, #d6c294 3px);
    box-shadow: inset 0 0 4px rgba(60,35,15,0.35);
    z-index: 5;
    pointer-events: none;
  }
  .book::before { left: 9px; border-radius: 3px 0 0 3px; }
  .book::after { right: 9px; border-radius: 0 3px 3px 0; }

  .spine {
    position: absolute;
    left: 50%;
    top: 24px;
    bottom: 24px;
    width: 22px;
    transform: translateX(-50%);
    background:
      repeating-linear-gradient(to bottom, transparent 0px, transparent 37px, rgba(214,183,133,0.4) 37px, rgba(214,183,133,0.4) 40px, transparent 40px, transparent 78px),
      linear-gradient(90deg, rgba(0,0,0,0.28), rgba(0,0,0,0.08) 30%, rgba(0,0,0,0.08) 70%, rgba(0,0,0,0.28));
    z-index: 30;
    pointer-events: none;
  }
  .single-page-mode .spine { display: none; }

  .ribbon {
    position: absolute;
    top: -6px;
    right: 46px;
    width: 13px;
    height: 42px;
    background: var(--ribbon);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
    z-index: 40;
    transition: right 0.5s cubic-bezier(.4,0,.2,1);
    pointer-events: none;
  }

  .leaves-area {
    position: relative;
    width: calc(var(--page-w) * var(--page-count));
    height: var(--page-h);
    perspective: 2600px;
    transition: width 0.25s ease;
  }

  .left-page, .right-page-under {
    position: absolute;
    top: 0;
    width: var(--page-w);
    height: var(--page-h);
    overflow: hidden;
  }
  .left-page { left: 0; border-radius: 8px 0 0 8px; }
  .right-page-under { left: var(--page-w); border-radius: 0 8px 8px 0; }
  .single-page-mode .left-page { display: none; }
  .single-page-mode .right-page-under { left: 0; border-radius: 8px; }

  .page-face { width: 100%; height: 100%; padding: 40px 36px 46px; position: relative; background: var(--paper); color: var(--ink); }
  .page-face::after { content:""; position:absolute; inset:0; box-shadow: inset 0 0 30px rgba(30,60,90,0.05); pointer-events:none; }

  .flip-leaf {
    position: absolute;
    top: 0;
    left: var(--page-w);
    width: var(--page-w);
    height: var(--page-h);
    transform-style: preserve-3d;
    transform-origin: left center;
    z-index: 25;
    visibility: hidden;
  }
  .single-page-mode .flip-leaf { left: 0; }
  .flip-leaf.animating { transition: transform 0.8s cubic-bezier(.45,.05,.35,1); }
  .flip-face { position:absolute; top:0; left:0; width:100%; height:100%; backface-visibility:hidden; overflow:hidden; }
  .flip-face.front { border-radius: 0 8px 8px 0; }
  .flip-face.back { transform: rotateY(180deg); border-radius: 8px 0 0 8px; }
  .single-page-mode .flip-face.front,
  .single-page-mode .flip-face.back { border-radius: 8px; }

  .shine { position:absolute; inset:0; background: linear-gradient(90deg, rgba(30,60,90,0.18), transparent 35%, transparent 65%, rgba(30,60,90,0.18)); opacity:0; pointer-events:none; }
  .flip-leaf.animating .shine { animation: shineSweep 0.8s cubic-bezier(.45,.05,.35,1); }
  @keyframes shineSweep { 0%{opacity:0;} 45%{opacity:0.5;} 55%{opacity:0.5;} 100%{opacity:0;} }

  .edge-shadow-left { position:absolute; top:0; bottom:0; left: var(--page-w); width:36px; background: linear-gradient(90deg, rgba(30,60,90,0.10), transparent); pointer-events:none; z-index:20; }
  .single-page-mode .edge-shadow-left { display:none; }

  .page-content {
    font-family: var(--content-font, 'Libre Caslon Text', serif);
    font-size: 15px;
    line-height: var(--content-line-height, 1.45);
    text-align: left;
    height: 100%;
    overflow: hidden;
  }
  .page-content p { margin: 0 0 0.55em 0; text-indent: var(--content-indent, 1.4em); }
  .page-content p.no-indent { text-indent: 0; }
  .page-content p.chapter-heading {
    font-weight: 700;
    font-size: 1.2em;
    margin-bottom: 0.9em;
    text-indent: 0;
    color: var(--accent);
  }
  .page-content p.subtitle-heading {
    font-weight: 700;
    margin-bottom: 0.7em;
    margin-top: 0.3em;
    text-indent: 0;
    color: var(--ink);
  }

  .page-content.title-page {
    display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;
    font-family: 'Libre Caslon Text', serif;
  }
  .page-content.title-page .t-title { font-size: 27px; font-weight:700; line-height:1.25; margin-bottom:16px; }
  .page-content.title-page .t-subtitle { font-family:'Inter',sans-serif; font-size:12.5px; line-height:1.5; max-width:290px; opacity:0.75; margin-bottom:6px; }
  .page-content.title-page .t-rule { width:56px; height:1px; background:currentColor; opacity:0.35; margin:16px 0; }
  .page-content.title-page .t-sub { font-family:'Inter',sans-serif; font-size:11.5px; letter-spacing:0.1em; text-transform:uppercase; opacity:0.65; }
  .page-content.end-page { display:flex; align-items:center; justify-content:center; height:100%; font-family:'Libre Caslon Text', serif; font-style:italic; font-size:20px; opacity:0.7; }

  .folio { position:absolute; bottom:18px; font-family:'Inter', sans-serif; font-size:11px; opacity:0.5; color: var(--accent); }
  .left-page .folio, .flip-face.back .folio { left:36px; }
  .right-page-under .folio, .flip-face.front .folio { right:36px; }

  .zone { position:absolute; top:0; height:100%; width:34%; z-index:60; cursor:pointer; }
  .zone.prev { left:0; }
  .zone.next { right:0; }

  .nav-btn {
    position:absolute; bottom:12px; z-index:70;
    width:38px; height:38px; border-radius:50%;
    border:1px solid #c9a877; background:#faf3e2; color:var(--accent);
    font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center;
    box-shadow: 0 4px 10px rgba(60,35,15,0.2);
  }
  .nav-btn:hover:not(:disabled) { background:#ecdfc0; }
  .nav-btn:disabled { opacity:0.3; cursor:default; }
  .nav-btn.prev-btn { left:-19px; }
  .nav-btn.next-btn { right:-19px; }

  .progress-wrap {
    position:absolute; bottom:26px; left:50%; transform:translateX(-50%);
    display:flex; align-items:center; gap:10px;
    font-family:'Inter', sans-serif; font-size:11px; color:#a9906a; z-index:50;
  }
  .progress-track { width:150px; height:2px; background:rgba(47,102,144,0.18); position:relative; }
  .progress-fill { position:absolute; top:0; left:0; height:100%; background:var(--accent); transition:width 0.4s ease; }

  .loading-note { position:absolute; bottom:-28px; left:50%; transform:translateX(-50%); font-family:'Inter', sans-serif; font-size:11px; color:#a9906a; }

  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }

  /* ---------- Lock screen ---------- */
  .lock-screen {
    position:fixed; inset:0; z-index:500;
    display:flex; align-items:center; justify-content:center;
    background: radial-gradient(ellipse at 50% 30%, var(--stage-bg-1), var(--stage-bg-2) 70%);
  }
  .lock-card {
    width:min(380px, 88vw);
    background: linear-gradient(160deg, var(--case-blue), var(--case-blue-dark));
    border-radius:8px; padding:36px 30px;
    box-shadow: 0 30px 70px rgba(60,35,15,0.35);
    text-align:center;
  }
  .lock-card .lock-icon { font-size:28px; margin-bottom:10px; }
  .lock-card h1 { font-family:'Libre Caslon Text', serif; font-weight:700; color:#fff; font-size:21px; margin:0 0 6px 0; }
  .lock-card p { font-family:'Inter', sans-serif; font-size:12.5px; color:#ecdfc0; line-height:1.5; margin:0 0 20px 0; }
  .lock-card input[type="text"] {
    width:100%; background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.3);
    color:#fff; padding:11px 12px; border-radius:4px; font-family:'Inter', sans-serif;
    font-size:14px; letter-spacing:0.04em; text-align:center; text-transform:uppercase;
  }
  .lock-card input[type="text"]::placeholder { color: rgba(255,255,255,0.6); }
  .lock-card .unlock-btn {
    width:100%; margin-top:12px; background:#faf3e2; color:var(--accent);
    border:none; padding:11px 12px; border-radius:4px; font-family:'Inter', sans-serif;
    font-weight:700; font-size:13px; cursor:pointer;
  }
  .lock-card .unlock-btn:hover { background:#ecdfc0; }
  .lock-card .unlock-btn:disabled { opacity:0.6; cursor:default; }
  .lock-error { font-family:'Inter', sans-serif; font-size:12px; color:#ffd9d4; margin-top:12px; min-height:16px; }
  .lock-buy-link { display:inline-block; margin-top:18px; font-family:'Inter', sans-serif; font-size:11.5px; color:#fff; text-decoration:underline; }
  .lock-dev-note { margin-top:16px; font-family:'Inter', sans-serif; font-size:10.5px; color:#d8c7a3; line-height:1.5; }

  /* ---------- Cover gate (closed book) ---------- */
  .cover-gate {
    position:fixed; inset:0; z-index:300;
    display:flex; align-items:center; justify-content:center;
    flex-direction: column;
    gap: 18px;
    background: radial-gradient(ellipse at 50% 30%, var(--stage-bg-1), var(--stage-bg-2) 70%);
    cursor:pointer;
  }
  .cover-gate-frame {
    width: min(360px, 78vw);
    aspect-ratio: 2 / 3;
    background: #faf3e2;
    border-radius: 4px;
    border: 11px solid #b8905a;
    box-shadow:
      inset 2px 2px 0 rgba(255,241,214,0.65),
      inset -2px -2px 0 rgba(83,54,24,0.65),
      inset 0 0 0 13px #8a6444,
      inset 0 0 0 14px #e9cf99,
      0 2px 0 rgba(255,241,214,0.4),
      0 18px 34px rgba(0,0,0,0.35),
      0 40px 80px rgba(60,35,15,0.45);
    display:flex; align-items:center; justify-content:center;
    overflow: visible;
    padding: 10px;
    position: relative;
  }
  .cover-gate-image { width:100%; height:100%; object-fit: contain; display:block; border-radius: 1px; }
  .cover-gate-hint {
    font-family:'Inter', sans-serif; font-size:13px; font-weight:600; letter-spacing:0.04em;
    color: var(--accent); background:#faf3e2; padding:9px 18px; border-radius:20px;
    box-shadow: 0 6px 16px rgba(60,35,15,0.2);
    animation: pulseHint 2.2s ease-in-out infinite;
  }
  @keyframes pulseHint { 0%,100%{ opacity:0.75; } 50%{ opacity:1; } }

  /* ---------- Ornate gold corner flourishes + gothic arch topper (shared: cover + frontispiece) ---------- */
  .ornate-corner {
    position: absolute;
    width: 42px;
    height: 42px;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%2064%2064%27%3E%3Cpath%20d%3D%27M4%2060%20L4%2022%20Q4%204%2022%204%20L60%204%27%20fill%3D%27none%27%20stroke%3D%27%23c9a877%27%20stroke-width%3D%272.6%27/%3E%3Cpath%20d%3D%27M4%2044%20Q18%2044%2018%2030%20Q18%2016%2032%2016%20Q46%2016%2046%204%27%20fill%3D%27none%27%20stroke%3D%27%23c9a877%27%20stroke-width%3D%271.4%27/%3E%3Cpath%20d%3D%27M4%204%20L13%204%20L4%2013%20Z%27%20fill%3D%27%23c9a877%27/%3E%3Ccircle%20cx%3D%2732%27%20cy%3D%2730%27%20r%3D%272%27%20fill%3D%27%23c9a877%27/%3E%3Ccircle%20cx%3D%2711%27%20cy%3D%2711%27%20r%3D%272.6%27%20fill%3D%27none%27%20stroke%3D%27%23c9a877%27%20stroke-width%3D%271.2%27/%3E%3Cpath%20d%3D%27M46%204%20Q52%204%2052%2010%20Q52%204%2058%204%27%20fill%3D%27none%27%20stroke%3D%27%23c9a877%27%20stroke-width%3D%271.2%27/%3E%3Cpath%20d%3D%27M4%2044%20Q4%2050%2010%2050%20Q4%2050%204%2056%27%20fill%3D%27none%27%20stroke%3D%27%23c9a877%27%20stroke-width%3D%271.2%27/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    pointer-events: none;
    z-index: 6;
  }
  .ornate-corner.tl { top: 6px; left: 6px; }
  .ornate-corner.tr { top: 6px; right: 6px; transform: scaleX(-1); }
  .ornate-corner.bl { bottom: 6px; left: 6px; transform: scaleY(-1); }
  .ornate-corner.br { bottom: 6px; right: 6px; transform: scale(-1,-1); }

  .gothic-arch {
    position: absolute;
    top: -22px;
    left: 50%;
    width: 84px;
    height: 48px;
    transform: translateX(-50%);
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%2084%2048%27%3E%3Cpath%20d%3D%27M8%2046%20Q8%2010%2042%204%20Q76%2010%2076%2046%27%20fill%3D%27none%27%20stroke%3D%27%23c9a877%27%20stroke-width%3D%273%27/%3E%3Cpath%20d%3D%27M8%2046%20L8%2036%20M76%2046%20L76%2036%27%20stroke%3D%27%23c9a877%27%20stroke-width%3D%273%27/%3E%3Ccircle%20cx%3D%2742%27%20cy%3D%274%27%20r%3D%274%27%20fill%3D%27%23c9a877%27/%3E%3Cpath%20d%3D%27M42%200%20L42%20-8%27%20stroke%3D%27%23c9a877%27%20stroke-width%3D%272.4%27/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    pointer-events: none;
    z-index: 6;
  }

  /* ---------- Cover page (first leaf inside the book itself) ---------- */
  .page-content.cover-page { display:flex; align-items:center; justify-content:center; height:100%; padding: 10px 0; }
  .cover-page-frame {
    position: relative;
    width: min(100%, 232px);
    aspect-ratio: 2 / 3;
    background: #faf3e2;
    border-radius: 3px;
    border: 7px solid #b8905a;
    box-shadow:
      inset 1px 1px 0 rgba(255,241,214,0.65),
      inset -1px -1px 0 rgba(83,54,24,0.65),
      inset 0 0 0 8px #8a6444,
      inset 0 0 0 9px #e9cf99,
      0 6px 18px rgba(60,35,15,0.25);
    display:flex; align-items:center; justify-content:center;
    overflow: visible;
    padding: 8px;
  }
  .cover-page-image { width:100%; height:100%; object-fit: cover; display:block; border-radius: 1px; }

  /* ---------- Frontispiece (the page opposite the title page) ---------- */
  .page-content.frontispiece-page { display:flex; align-items:center; justify-content:center; height:100%; padding: 10px 0 0 0; }
  .frontispiece-frame {
    position: relative;
    width: 100%; height: 100%;
    display:flex; align-items:flex-start; justify-content:center;
    padding: 24px 24px 42px;
    border: 2px solid #c9a877;
    box-shadow: inset 0 0 0 1px rgba(201,168,119,0.55), inset 0 0 26px rgba(139,100,50,0.10);
    box-sizing: border-box;
  }
  .frontispiece-text {
    font-family: var(--content-font, 'Libre Caslon Text', serif);
    font-style: italic;
    font-size: 11.5px;
    line-height: 1.42;
    text-align: left;
    color: var(--ink);
    width: 100%;
  }
  .frontispiece-text p { margin: 0 0 0.42em 0; text-indent: var(--content-indent, 1.4em); }
  .frontispiece-rule { width:70px; height:1px; background:#c9a877; opacity:0.7; margin: 10px auto 0; }

  /* ---------- Modal (load a book) ---------- */
  .modal-backdrop { position:fixed; inset:0; background:rgba(20,40,60,0.45); display:none; align-items:center; justify-content:center; z-index:200; }
  .modal-backdrop.open { display:flex; }
  .modal { width:min(560px, 90vw); max-height:80vh; background:#faf3e2; border:1px solid #c9a877; border-radius:6px; padding:22px; display:flex; flex-direction:column; gap:12px; }
  .modal h2 { font-family:'Libre Caslon Text', serif; color:var(--accent); margin:0 0 4px 0; font-size:19px; font-weight:700; }
  .modal label { font-family:'Inter', sans-serif; font-size:12px; color:#a9906a; }
  .modal input[type="text"] { width:100%; background:#f1e3c2; border:1px solid #c9a877; color:#2b2113; padding:9px 10px; border-radius:3px; font-family:'Inter', sans-serif; font-size:14px; }
