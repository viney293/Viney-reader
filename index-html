  // ---------- Render (static, no animation) ----------
  function renderStatic(){
    var pages = state.pages;
    var cur = state.current;

    if (state.pageCount === 1){
      var only = pages[cur];
      var m = pageMarkup(only);
      underContent.className = "page-content" + pageTypeClass(only);
      underContent.innerHTML = m.content;
      underFolio.textContent = m.folio;
      leftContent.innerHTML = "";
      leftFolio.textContent = "";
    } else {
      var pair = getDisplayedPair(cur);

      var l = pageMarkup(pair.left);
      leftContent.className = "page-content" + pageTypeClass(pair.left);
      leftContent.innerHTML = l.content;
      leftFolio.textContent = l.folio;

      var r = pageMarkup(pair.right);
      underContent.className = "page-content" + pageTypeClass(pair.right);
      underContent.innerHTML = r.content;
      underFolio.textContent = r.folio;
    }

    flipLeaf.classList.remove("animating");
    flipLeaf.style.transform = "rotateY(0deg)";
    flipLeaf.style.visibility = "hidden";
    frontContent.innerHTML = ""; backContent.innerHTML = "";
    frontFolio.textContent = ""; backFolio.textContent = "";

    updateChrome();
  }

  function updateChrome(){
    var total = state.pages.length;
    var cur = state.current;
    progressLabel.textContent = Math.min(cur + 1, total) + " / " + total;
    progressFill.style.width = (total > 1 ? (cur / (total - 1)) * 100 : 0) + "%";
    ribbon.style.right = (46 + (cur / Math.max(1, total - 1)) * 160) + "px";
    $("prevBtn").disabled = computeTarget(cur, -1, state.pageCount, total) === null;
    $("nextBtn").disabled = computeTarget(cur, 1, state.pageCount, total) === null;
    var announcer = $("pageAnnouncer");
    if (announcer) announcer.textContent = "Page " + Math.min(cur + 1, total) + " of " + total;
  }

  // ---------- Flip animation ----------
  function goNext(){ flip(1); }
  function goPrev(){ flip(-1); }

  function flip(direction){
    if (state.animating) return;
    var pages = state.pages;
    var cur = state.current;
    var target = computeTarget(cur, direction, state.pageCount, pages.length);
    if (target === null) return;

    if (narration.active) stopNarration();

    var osReducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (osReducedMotion){
      state.current = target;
      renderStatic();
      return;
    }

    state.animating = true;
    flipLeaf.classList.remove("animating");
    flipLeaf.style.visibility = "visible";

    if (state.pageCount === 1){
      // Single page at a time: cur and target are always adjacent, so this is
      // a plain one-leaf flip between exactly those two pages.
      var L = Math.min(cur, target);
      var pageL = pages[L];
      var pageR = pages[L + 1];
      var mL = pageMarkup(pageL);
      var mR = pageMarkup(pageR);
      frontContent.className = "page-content" + pageTypeClass(pageL);
      frontContent.innerHTML = mL.content;
      frontFolio.textContent = mL.folio;
      backContent.className = "page-content" + pageTypeClass(pageR);
      backContent.innerHTML = mR.content;
      backFolio.textContent = mR.folio;

      var destObj = pages[target];
      var mDest = pageMarkup(destObj);
      underContent.className = "page-content" + pageTypeClass(destObj);
      underContent.innerHTML = mDest.content;
      underFolio.textContent = mDest.folio;
    } else {
      // Two-page spread: turning reveals a whole new pair, just like a real
      // book. The left page swaps instantly (no animation); the right page
      // is what visibly flips, from the old right page to the new one.
      var oldPair = getDisplayedPair(cur);
      var newPair = getDisplayedPair(target);

      var lm = pageMarkup(newPair.left);
      leftContent.className = "page-content" + pageTypeClass(newPair.left);
      leftContent.innerHTML = lm.content;
      leftFolio.textContent = lm.folio;

      var mFront = pageMarkup(oldPair.right);
      var mBack = pageMarkup(newPair.right);
      frontContent.className = "page-content" + pageTypeClass(oldPair.right);
      frontContent.innerHTML = mFront.content;
      frontFolio.textContent = mFront.folio;
      backContent.className = "page-content" + pageTypeClass(newPair.right);
      backContent.innerHTML = mBack.content;
      backFolio.textContent = mBack.folio;

      underContent.className = "page-content" + pageTypeClass(newPair.right);
      underContent.innerHTML = mBack.content;
      underFolio.textContent = mBack.folio;
    }

    if (direction === 1){
      flipLeaf.style.transform = "rotateY(0deg)";
      void flipLeaf.offsetWidth;
      flipLeaf.classList.add("animating");
      flipLeaf.style.transform = "rotateY(-180deg)";
    } else {
      flipLeaf.style.transform = "rotateY(-180deg)";
      void flipLeaf.offsetWidth;
      flipLeaf.classList.add("animating");
      flipLeaf.style.transform = "rotateY(0deg)";
    }

    var done = function(e){
      if (e && e.target !== flipLeaf) return;
      flipLeaf.removeEventListener("transitionend", done);
      state.current = target;
      state.animating = false;
      renderStatic();
    };
    flipLeaf.addEventListener("transitionend", done);
  }

  // ---------- Page-layout mode (1 page / 2 page) ----------
  function setPageCount(n){
    if (n !== state.pageCount){
      if (n === 1){
        // Switching to single-page: point at whichever page was the "active"
        // (right-hand) page of the current spread.
        state.current = (state.current === 0) ? 0 : state.current + 1;
      } else {
        // Switching to two-page: snap to the nearest valid pair-start index
        // (0, or the nearest odd number at/below the current single-page index).
        var s = state.current;
        state.current = (s <= 0) ? 0 : (s % 2 === 1 ? s : s - 1);
      }
    }
    state.pageCount = n;
    document.documentElement.style.setProperty("--page-count", n);
    leavesArea.classList.toggle("single-page-mode", n === 1);
    bookEl.classList.toggle("single-page-mode", n === 1);
    $("onePageBtn").classList.toggle("active", n === 1);
    $("twoPageBtn").classList.toggle("active", n === 2);
    $("onePageBtn").setAttribute("aria-pressed", n === 1 ? "true" : "false");
    $("twoPageBtn").setAttribute("aria-pressed", n === 2 ? "true" : "false");
    renderStatic();
    rescale();
  }
  $("onePageBtn").addEventListener("click", function(){ setPageCount(1); });
  $("twoPageBtn").addEventListener("click", function(){ setPageCount(2); });

  // ---------- Scaling to viewport ----------
  var stageEl = document.querySelector(".stage");

  function rescale(){
    var pageW = 440, pageH = 620;
    var bookW = pageW * state.pageCount + 56 + 56;
    var bookH = pageH + 48 + 80;
    var availW = window.innerWidth - 60;
    var availH = window.innerHeight - 120;
    var scale = Math.min(availW / bookW, availH / bookH, 1.1);
    state.fitScale = Math.max(0.35, scale);
    applyScale();
  }
  function applyScale(){
    var combined = state.fitScale * state.zoom;
    document.documentElement.style.setProperty("--scale", combined);
    stageEl.classList.toggle("zoomed", state.zoom > 1.001);
  }
  function setZoom(next){
    state.zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, next));
    applyScale();
    updateZoomChrome();
  }
  function updateZoomChrome(){
    $("zoomMinus").disabled = state.zoom <= ZOOM_MIN + 0.001;
    $("zoomPlus").disabled = state.zoom >= ZOOM_MAX - 0.001;
  }

  // ---------- Events ----------
  $("nextBtn").addEventListener("click", goNext);
  $("prevBtn").addEventListener("click", goPrev);
  function zoneClick(handler){
    return function(){
      if (window.getSelection().toString().length > 0) return;
      handler();
    };
  }
  $("zoneNext").addEventListener("click", zoneClick(goNext));
  $("zonePrev").addEventListener("click", zoneClick(goPrev));

  document.addEventListener("keydown", function(e){
    if (e.key === "ArrowRight" || e.key === " ") { e.preventDefault(); goNext(); }
    else if (e.key === "ArrowLeft") { e.preventDefault(); goPrev(); }
  });

  window.addEventListener("resize", rescale);
  $("zoomMinus").addEventListener("click", function(){ setZoom(state.zoom - ZOOM_STEP); });
  $("zoomPlus").addEventListener("click", function(){ setZoom(state.zoom + ZOOM_STEP); });
  $("zoomReset").addEventListener("click", function(){ setZoom(1); stageEl.scrollTop = 0; stageEl.scrollLeft = 0; });
  stageEl.addEventListener("wheel", function(e){
    if (!(e.ctrlKey || e.metaKey)) return;
    e.preventDefault();
    setZoom(state.zoom + (e.deltaY < 0 ? ZOOM_STEP : -ZOOM_STEP));
  }, { passive: false });

  // ---------- Cover gate (closed book) ----------
  var coverGate = $("coverGate");
  coverGate.addEventListener("click", function(){
    coverGate.style.display = "none";
  });

  // ---------- Load-a-book modal ----------
  var modalBackdrop = $("modalBackdrop");
  // Populated right after a successful .docx upload with each paragraph's
  // original Word style (heading / subtitle / body), in the same order as
  // the paragraphs dropped into the textarea. Used at "Open book" time to
  // carry chapter headings over instead of flattening the whole book into
  // plain body paragraphs. Cleared whenever the user edits the textarea by
  // hand, loads a plain .txt file, or reopens the modal, so it never gets
  // applied against text it no longer matches.
  var pendingDocxStructure = null;
  $("openLoad").addEventListener("click", function(){
    if (narration.active) stopNarration();
    $("titleInput").value = state.title;
    $("authorInput").value = state.author;
    setLoadStatus("", false);
    pendingDocxStructure = null;
    modalBackdrop.classList.add("open");
  });
  $("textInput").addEventListener("input", function(){ pendingDocxStructure = null; });
  $("cancelLoad").addEventListener("click", function(){ modalBackdrop.classList.remove("open"); });
  var loadStatus = $("loadStatus");
  function setLoadStatus(msg, isError){
    loadStatus.textContent = msg || "";
    loadStatus.classList.toggle("error", !!isError);
  }
  $("fileTrigger").addEventListener("click", function(){ $("fileInput").click(); });
  $("fileInput").addEventListener("change", function(e){
    var file = e.target.files[0];
    if (!file) return;
    var name = file.name || "";
    var isDocx = /\.docx$/i.test(name);
    setLoadStatus("Reading " + name + "\u2026", false);

    if (isDocx){
      if (!window.mammoth){
        setLoadStatus("Could not load the .docx reader (are you offline?). Try again, or paste the text instead.", true);
        return;
      }
      pendingDocxStructure = null;
      var reader = new FileReader();
      reader.onerror = function(){ setLoadStatus("Couldn't read that file. Try again, or paste the text instead.", true); };
      reader.onload = function(ev){
        // Convert to HTML rather than mammoth's plain "raw text" mode: this
        // gives us one <p>/<hN> per real Word paragraph, so we can rebuild
        // clean blank-line-separated paragraphs ourselves (instead of
        // trusting how mammoth joins raw text internally) AND remember which
        // paragraphs were styled as Word headings, so chapters can still
        // start on a fresh page with heading styling instead of collapsing
        // into one long stream of identical body paragraphs.
        window.mammoth.convertToHtml({ arrayBuffer: ev.target.result })
          .then(function(result){
            var doc = new DOMParser().parseFromString(result.value, "text/html");
            var blocks = doc.body.querySelectorAll("p, h1, h2, h3, h4, h5, h6, li");
            var paras = [];
            var structure = [];
            blocks.forEach(function(el){
              var t = el.textContent.replace(/\s+/g, " ").trim();
              if (!t) return;
              paras.push(t);
              var tag = el.tagName.toLowerCase();
              var kind = "body";
              if (tag === "h1" || tag === "h2") kind = "heading";
              else if (tag === "h3" || tag === "h4" || tag === "h5" || tag === "h6") kind = "subtitle";
              structure.push({ text: t, kind: kind });
            });
            if (!paras.length){
              setLoadStatus("That .docx file looks empty once the formatting is stripped out.", true);
              return;
            }
            pendingDocxStructure = structure;
            $("textInput").value = paras.join("\n\n");
            var headingCount = structure.filter(function(s){ return s.kind !== "body"; }).length;
            var structureNote = headingCount ? (" " + headingCount + " heading" + (headingCount === 1 ? "" : "s") + " detected and will carry over as chapter breaks.") : "";
            setLoadStatus(name + " loaded (" + paras.length + " paragraphs)." + structureNote + " Review the text below, then tap Open book.", false);
          })
          .catch(function(){
            setLoadStatus("Couldn't read that .docx file. It may be corrupted, password-protected, or a .doc (old format) file — try re-saving it as .docx, or paste the text instead.", true);
          });
      };
      reader.readAsArrayBuffer(file);
    } else {
      pendingDocxStructure = null;
      var txtReader = new FileReader();
      txtReader.onerror = function(){ setLoadStatus("Couldn't read that file. Try again, or paste the text instead.", true); };
      txtReader.onload = function(ev){
        $("textInput").value = ev.target.result;
        setLoadStatus(name + " loaded. Review the text below, then tap Open book.", false);
      };
      txtReader.readAsText(file);
    }
  });
  $("confirmLoad").addEventListener("click", function(){
    var text = $("textInput").value.trim();
    if (!text){ modalBackdrop.classList.remove("open"); return; }
    state.title = $("titleInput").value.trim() || "Untitled";
    state.author = $("authorInput").value.trim();
    $("brandTitle").textContent = state.title;
    // Loading custom text falls back to one paragraph per page (no heading
    // detection possible for arbitrary text), split on blank lines.
    var customParas = text.split(/\n\s*\n+/).map(function(s){ return s.trim(); }).filter(Boolean);
    BOOK_BODY_PARAS.length = 0;
    Array.prototype.push.apply(BOOK_BODY_PARAS, customParas);
    Object.keys(HEADINGS_SET).forEach(function(k){ delete HEADINGS_SET[k]; });
    Object.keys(SUBTITLES_SET).forEach(function(k){ delete SUBTITLES_SET[k]; });
    // If this text still exactly matches what came straight from a .docx
    // upload (i.e. the user didn't edit it afterwards), carry its Word
    // heading structure over so chapters still start on a new page and
    // read with heading styling, instead of every paragraph looking the same.
    if (pendingDocxStructure && pendingDocxStructure.length === customParas.length &&
        pendingDocxStructure.every(function(s, i){ return s.text === customParas[i]; })){
      pendingDocxStructure.forEach(function(s){
        if (s.kind === "heading") HEADINGS_SET[s.text] = true;
        else if (s.kind === "subtitle") SUBTITLES_SET[s.text] = true;
      });
    }
    state.current = 0;
    var saved = saveCustomBookToStorage();
    paginate();
    renderStatic();
    if (saved){
      modalBackdrop.classList.remove("open");
    } else {
      // The book itself already loaded fine into this session — saving to
      // the device just didn't succeed, most likely because the book is
      // large and the browser's storage quota is tight. Keep the modal
      // open so this is actually seen, rather than closing it and losing
      // the book silently on the next reload.
      setLoadStatus("Loaded and open now, but couldn't be saved to this device (storage may be full) \u2014 it'll revert on reload. Try a shorter book, or free up browser storage.", true);
    }
  });
  $("restoreOriginal").addEventListener("click", function(){
    try { localStorage.removeItem(CUSTOM_BOOK_KEY); } catch(e){}
    applyBookData(DEFAULT_BOOK);
    $("brandTitle").textContent = state.title;
    state.current = 0;
    modalBackdrop.classList.remove("open");
    paginate();
    renderStatic();
  });
  modalBackdrop.addEventListener("click", function(e){
    if (e.target === modalBackdrop) modalBackdrop.classList.remove("open");
  });

  // ---------- Access gate ----------
  var lockScreen = $("lockScreen");
  var lockInput = $("lockInput");
  var lockError = $("lockError");
  var unlockBtn = $("unlockBtn");
  var lockDevNote = $("lockDevNote");
  $("lockBuyLink").href = BUY_PAGE_URL;

  function grantAccess(){ lockScreen.style.display = "none"; }

  function attemptUnlock(key){
    lockError.textContent = "";
    unlockBtn.disabled = true;
    unlockBtn.textContent = "Checking…";
    fetch(ACCESS_CHECK_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ license_key: key })
    }).then(function(res){ return res.json(); })
      .then(function(data){
        unlockBtn.disabled = false;
        unlockBtn.textContent = "Unlock my book";
        if (data && data.valid){
          try { localStorage.setItem(STORAGE_KEY, key); } catch(e){}
          grantAccess();
        } else {
          lockError.textContent = "That key doesn't look right — check for typos, or use the key from your purchase email.";
        }
      })
      .catch(function(){
        unlockBtn.disabled = false;
        unlockBtn.textContent = "Unlock my book";
        lockError.textContent = "Couldn't reach the access check right now. Please try again in a moment.";
      });
  }
  unlockBtn.addEventListener("click", function(){
    var key = lockInput.value.trim();
    if (!key){ lockError.textContent = "Enter your access key first."; return; }
    attemptUnlock(key);
  });
  lockInput.addEventListener("keydown", function(e){ if (e.key === "Enter") unlockBtn.click(); });

  (function initGate(){
    if (DEV_MODE){
      lockDevNote.style.display = "block";
      lockDevNote.textContent = "Dev mode: no worker URL is set yet, so this screen isn't gating anything.";
      grantAccess();
      return;
    }
    var stored = null;
    try { stored = localStorage.getItem(STORAGE_KEY); } catch(e){}
    if (stored){ grantAccess(); return; }
    var urlKey = new URLSearchParams(window.location.search).get("key");
    if (urlKey){
      lockInput.value = urlKey;
      attemptUnlock(urlKey);
    }
  })();

  // ---------- Init ----------
  $("brandTitle").textContent = state.title;
  if (!window.speechSynthesis){ narrateBtn.style.display = "none"; if (voiceSettingsBtn) voiceSettingsBtn.style.display = "none"; }
  setPageCount(2);
  rescale();
  updateZoomChrome();

  // Wait for the actual book fonts to finish loading (and for the browser to
  // have actually painted with them, not just resolved the load promise)
  // before measuring pages. Pagination run too early, or against a font that
  // hasn't visually taken effect yet, locks in wrong measurements — this is
  // a known source of unreliable pagination, especially in mobile WebViews.
  loadingNote.style.display = "block";

  function runPaginationWhenReady(){
    function afterTwoFrames(cb){
      requestAnimationFrame(function(){ requestAnimationFrame(cb); });
    }
    afterTwoFrames(function(){
      paginate();
      renderStatic();
    });
  }

  if (document.fonts && document.fonts.load){
    Promise.all([
      document.fonts.load('400 15px "Libre Caslon Text"'),
      document.fonts.load('700 15px "Libre Caslon Text"'),
      document.fonts.load('italic 400 15px "Libre Caslon Text"')
    ]).catch(function(){ /* fall through even if a variant fails to load */ })
      .then(function(){
        if (document.fonts.ready){
          document.fonts.ready.then(runPaginationWhenReady);
        } else {
          runPaginationWhenReady();
        }
      });
  } else {
    runPaginationWhenReady();
  }

  if ("serviceWorker" in navigator && (location.protocol === "https:" || location.hostname === "localhost")){
    window.addEventListener("load", function(){
      navigator.serviceWorker.register("sw.js").catch(function(){});
    });
  }
})();
</script>
</body>
</html>
