    }
    function fits(segments){ return heightOf(segments) <= maxHeight; }

    // Word-boundary offsets within a paragraph's text, used to find the
    // longest prefix that still fits on the current page, so a paragraph
    // can be split cleanly between words rather than leaving the rest of
    // the page blank just because the whole paragraph didn't fit.
    function wordBreakPoints(text){
      var points = [];
      var re = /\s+/g;
      var m;
      while ((m = re.exec(text))) points.push(m.index);
      points.push(text.length);
      return points;
    }

    // Binary-search the word-break points for the longest slice of `text`
    // (starting at `from`) that, appended to `segs`, still fits on the page.
    // Returns the end offset, or `from` if not even one more word fits.
    function findSplitPoint(segs, text, from){
      var points = wordBreakPoints(text).filter(function(p){ return p > from; });
      var lo = 0, hi = points.length - 1, best = from;
      while (lo <= hi){
        var mid = (lo + hi) >> 1;
        var end = points[mid];
        var candidate = segs.concat([{ idx: curParaIdx, kind: "partial", start: from, end: end }]);
        if (fits(candidate)){
          best = end;
          lo = mid + 1;
        } else {
          hi = mid - 1;
        }
      }
      return best;
    }

    var pages = [];
    pages.push({ type: "cover" });
    pages.push({ type: "title" });
    pages.push({ type: "frontispiece" });

    var paraIdx = 0;
    var resumeStart = 0; // char offset to resume mid-paragraph after a split
    var total = BOOK_BODY_PARAS.length;
    var guardOuter = 0;
    var curParaIdx = 0; // used by findSplitPoint's closure above

    // Minimum leftover height worth splitting off onto the current page —
    // avoids stranding a single short word alone at the top of the next
    // page just to shave a sliver off this one.
    var MIN_SPLIT_GAIN = 28; // px, roughly one line

    while (paraIdx < total && guardOuter < 20000){
      guardOuter++;
      var segs = [];
      var pageHasContent = false;
      var guardInner = 0;

      while (paraIdx < total && guardInner < 20000){
        guardInner++;
        curParaIdx = paraIdx;
        var text = BOOK_BODY_PARAS[paraIdx];
        var heading = isHeading(text);
        var subtitle = isSubtitle(text);
        var isFreshPara = (resumeStart === 0);

        if ((heading || subtitle) && pageHasContent && isFreshPara){
