  // ---------- Text appearance (font, line spacing, paragraph indent) ----------
  var DEFAULT_TEXT_SETTINGS = { font: "'Libre Caslon Text', serif", lineHeight: 1.45, indent: 1.4 };

  function applyTextSettings(settings){
    document.documentElement.style.setProperty("--content-font", settings.font);
    document.documentElement.style.setProperty("--content-line-height", settings.lineHeight);
    document.documentElement.style.setProperty("--content-indent", settings.indent + "em");
  }

  function loadTextSettings(){
    var settings = { font: DEFAULT_TEXT_SETTINGS.font, lineHeight: DEFAULT_TEXT_SETTINGS.lineHeight, indent: DEFAULT_TEXT_SETTINGS.indent };
    try {
      var savedFont = localStorage.getItem(FONT_PREF_KEY);
      var savedLH = parseFloat(localStorage.getItem(LINEHEIGHT_PREF_KEY));
      var savedIndent = parseFloat(localStorage.getItem(INDENT_PREF_KEY));
      if (savedFont) settings.font = savedFont;
      if (isFinite(savedLH) && savedLH) settings.lineHeight = savedLH;
      if (isFinite(savedIndent) || savedIndent === 0) settings.indent = savedIndent;
