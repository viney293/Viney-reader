    if (voice) utt.voice = voice;
    utt.onend = function(){
      if (!narration.active) return;
      var t = computeTarget(state.current, 1, state.pageCount, state.pages.length);
      if (t === null){ stopNarration(); return; }
      // Advance silently (no flip animation) so continuous narration stays smooth.
      state.current = t;
      renderStatic();
      speakCurrentPage();
    };
    utt.onerror = function(){ stopNarration(); };
    window.speechSynthesis.speak(utt);
  }

