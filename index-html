          var withSub = segs.concat([{ idx: paraIdx, kind: "full" }]);
          if (!fits(withSub)) break;
          if (maxHeight - heightOf(withSub) < MIN_TRAILING_AFTER_SUBTITLE) break;
          // otherwise fall through and place the subtitle below
        }

        var candidateSeg = isFreshPara
          ? { idx: paraIdx, kind: "full" }
          : { idx: paraIdx, kind: "partial", start: resumeStart, end: text.length };
        var candidate = segs.concat([candidateSeg]);

        if (fits(candidate)){
          segs = candidate;
          pageHasContent = true;
          paraIdx++;
          resumeStart = 0;
          continue;
        }

        // Whole paragraph (or remaining slice) doesn't fit. If the page
        // already has content and this isn't a heading/subtitle (those
        // always start clean on their own line), try splitting it at a
        // word boundary to fill out the rest of this page.
        if (pageHasContent && !heading && !subtitle){
          var splitEnd = findSplitPoint(segs, text, resumeStart);
          if (splitEnd > resumeStart){
            var partialCandidate = segs.concat([{ idx: paraIdx, kind: "partial", start: resumeStart, end: splitEnd }]);
            if (heightOf(partialCandidate) - heightOf(segs) >= MIN_SPLIT_GAIN || splitEnd >= text.length - 1){
              segs = partialCandidate;
              resumeStart = splitEnd;
              break; // page is full; paraIdx stays put, resumeStart carries to next page
            }
          }
