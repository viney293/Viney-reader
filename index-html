  // fragments. (An earlier version of this code split paragraphs across
  // pages to fill them more fully; that's what caused the broken gaps and
  // mixed-up indenting, so it's been removed in favor of this simpler,
  // reliable approach.)
  // The two heading rules are unchanged: a chapter heading always starts a
  // brand-new page, and an in-chapter subtitle is only placed on a page if
  // there's also room left for at least a few lines of body text under it —
  // otherwise it's pushed to the next page instead, so a subtitle never ends
  // up stranded at the very bottom.
  var MIN_TRAILING_AFTER_SUBTITLE = 70; // px

  function segmentHtml(seg){
    var text = BOOK_BODY_PARAS[seg.idx];
    var slice = seg.kind === "full" ? text : text.slice(seg.start, seg.end);
    var isParaStart = seg.kind === "full" || seg.start === 0;
    var cls = "";

    if (isParaStart && isHeading(text)){
      cls = ' class="chapter-heading"';
    } else if (isParaStart && isSubtitle(text)){
      cls = ' class="subtitle-heading"';
    } else {
      // No first-line indent when: this is the continuation of a paragraph
      // split across a page turn, or this is the first ordinary paragraph
      // right after a chapter heading / subtitle (standard book convention).
      var noIndent = !isParaStart;
      if (isParaStart && seg.idx > 0){
        var prevText = BOOK_BODY_PARAS[seg.idx - 1];
        if (isHeading(prevText) || isSubtitle(prevText)) noIndent = true;
      }
