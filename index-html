  // Web Speech API doesn't expose accent or gender directly — only whatever
  // voices the device/browser happens to have installed, each with a name
  // and a language tag. Until real voice cloning is wired up, this picks
  // the closest available match: prefer a South African English/Afrikaans
  // voice, and within that (or as a fallback across any English voice),
  // prefer one whose name suggests a male voice, using the common names
  // each platform (Chrome/Android, Edge/Windows, Safari/macOS) ships.
  function pickNarrationVoice(){
    if (!window.speechSynthesis) return null;
    var voices = window.speechSynthesis.getVoices() || [];
    if (!voices.length) return null;
    var savedURI = null;
    try { savedURI = localStorage.getItem(VOICE_PREF_KEY); } catch(e){}
    if (savedURI){
      var chosen = voices.filter(function(v){ return v.voiceURI === savedURI; })[0];
      if (chosen) return chosen;
    }
    var maleNames = ["male", "david", "daniel", "george", "james", "mark", "fred", "arthur", "oliver", "guy", "ryan", "thabo", "sipho", "will", "alex", "tom", "liam", "ravi", "rishi", "idris", "gordon", "sean", "brian"];
    var femaleNames = ["female", "zira", "samantha", "victoria", "karen", "susan", "fiona", "tessa", "moira", "veena", "salli", "joanna", "kendra", "kimberly", "amy", "emma", "ivy", "serena", "allison", "ava", "siri", "sara", "linda", "heera"];
    function score(v){
      var name = (v.name || "").toLowerCase();
      var lang = (v.lang || "").toLowerCase();
      var s = 0;
      // Language comes first: a voice that isn't English at all will
      // mispronounce the book's English text, so it's only ever chosen if
      // truly nothing English-language exists on the device.
      if (lang.indexOf("en") !== 0) s -= 1000;
      else if (lang === "en-za") s += 300;             // closest match available
      else if (lang === "en-ng" || lang === "en-ke" || lang === "en-gh") s += 220; // other African English
      else if (lang === "en-in") s += 150;
      else if (lang === "en-au" || lang === "en-nz" || lang === "en-ie") s += 120; // Commonwealth, not US/UK
      else if (lang === "en-gb") s += 40;              // explicitly one of the accents asked to avoid
      else if (lang === "en-us") s += 20;              // explicitly the other accent asked to avoid
      else s += 80;                                    // unspecified "en" — treat as neutral

      var isMale = false, isFemale = false;
      for (var i=0;i<maleNames.length;i++){ if (name.indexOf(maleNames[i]) !== -1){ isMale = true; break; } }
      for (var j=0;j<femaleNames.length;j++){ if (name.indexOf(femaleNames[j]) !== -1){ isFemale = true; break; } }
      if (isMale) s += 150;
      if (isFemale) s -= 150;
      return s;
    }
    var best = null, bestScore = -Infinity;
    voices.forEach(function(v){
      var s = score(v);
      if (s > bestScore){ bestScore = s; best = v; }
    });
    return best;
  }

  function speakCurrentPage(){
