  function paginate(){
    loadingNote.style.display = "block";
    var maxHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--page-h')) - 86;

    function heightOf(segments){
      measurer.innerHTML = segments.map(segmentHtml).join("");
