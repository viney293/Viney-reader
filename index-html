          // page on its own (rare). Give it the page to itself rather than
          // loop forever; the very bottom may get visually clipped, which
          // is a far better failure mode than broken pagination.
          segs.push(isFreshPara ? { idx: paraIdx, kind: "full" } : { idx: paraIdx, kind: "partial", start: resumeStart, end: text.length });
          paraIdx++;
          resumeStart = 0;
        }
        break;
      }

      pages.push({ type: "content", segments: segs });
    }

    pages.push({ type: "end" });
    state.pages = pages;
    if (state.current >= pages.length) state.current = pages.length - 1;
    loadingNote.style.display = "none";
